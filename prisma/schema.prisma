// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  User
  Admin
}

enum PoolCategory {
  BulkPurchase
  Ajo
  Fundraising
  Repair
  Investment
  GroupGift
  Education
  Custom
}

enum PoolStatus {
  OPEN
  ALMOSTFUL
  CLOSED
  FUNDED
  DISBURSING
  COMPLETED
  EXPIRED
  REFUNDING
  REFUNDED
}

enum MembershipState {
  JOINED
  AWAITING_PAYMENT
  PAID
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

model User {
  id           String    @id @default(uuid())
  avatar       String?
  firstName    String
  lastName     String
  phone        String?   @unique
  email        String    @unique
  name         String
  password     String
  otp          String?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)
  role         Role      @default(User)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  refreshTokens   RefreshToken[]

  leadingPools     Pool[]       @relation("PoolLeader")
  beneficiaryPools Pool[]       @relation("PoolBeneficiary")
  createdPools     Pool[]       @relation("PoolCreator")
  memberships      Membership[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  tokenHash String
  isRevoked Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}

model Pool {
  id String @id @default(uuid())

  leaderId String
  leader   User   @relation("PoolLeader", fields: [leaderId], references: [id])

  name        String
  description String?
  category    PoolCategory @default(Custom)

  targetAmount     Int
  amountRaised     Int     @default(0)
  maxMembers       Int
  slotRemaining    Int     @default(0)
  splitEven             Boolean @default(true)
  memberShareAmount Int

  beneficiaryAccountNumber String
  beneficiaryBankName      String
  beneficiaryAccountName   String?
  beneficiaryUserId        String?
  beneficiaryUser          User?   @relation("PoolBeneficiary", fields: [beneficiaryUserId], references: [id])

  shareToken String @unique @default(uuid())

  deadlineAt DateTime
  status     PoolStatus @default(OPEN)

  memberships Membership[]

  createdById      String?
  createdBy        User?   @relation("PoolCreator", fields: [createdById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  stateChangedAt DateTime @default(now())

  @@map("pools")
}

model Membership {
  id String @id @default(uuid())

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  state    MembershipState @default(JOINED)
  joinedAt DateTime        @default(now())

  @@unique([poolId, userId])
  @@map("memberships")
}
