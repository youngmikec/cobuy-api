// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  User
  Admin
}

enum PoolStatus {
  OPEN
  ALMOSTFUL
  CLOSED
  FUNDED
  DISBURSING
  COMPLETED
  EXPIRED
  REFUNDING
  REFUNDED
}

enum MembershipState {
  JOINED
  AWAITING_PAYMENT
  PAID
  REFUND_PENDING
  REFUNDED
  REFUND_FAILED
}

enum TransactionState {
  PENDING
  PAID
  OVERPAID
  UNDERPAID
  EXPIRED
  FAILED
}

enum RefundState {
  INITIATED
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(uuid())
  avatar       String?
  firstName    String
  lastName     String
  phone        String?   @unique
  email        String    @unique
  name         String
  password     String
  otp          String?
  otpExpiresAt DateTime?
  isVerified   Boolean   @default(false)
  role         Role      @default(User)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  refreshTokens   RefreshToken[]

  leadingPools     Pool[]       @relation("PoolLeader")
  beneficiaryPools Pool[]       @relation("PoolBeneficiary")
  createdPools     Pool[]       @relation("PoolCreator")
  memberships      Membership[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  tokenHash String
  isRevoked Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}

model Pool {
  id String @id @default(uuid())

  leaderId String
  leader   User   @relation("PoolLeader", fields: [leaderId], references: [id])

  name        String
  description String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  targetAmount     Int
  amountRaised     Int     @default(0)
  maxMembers       Int
  slotRemaining    Int     @default(0)
  splitEven             Boolean @default(true)
  memberShareAmount Int

  beneficiaryAccountNumber String
  beneficiaryBankName      String
  // Monnify bank code for beneficiaryBankName — nullable since pools created
  // before this field existed have no value to backfill it from.
  beneficiaryBankCode      String?
  beneficiaryAccountName   String?
  beneficiaryUserId        String?
  beneficiaryUser          User?   @relation("PoolBeneficiary", fields: [beneficiaryUserId], references: [id])

  shareToken String @unique @default(uuid())

  deadlineAt DateTime
  status     PoolStatus @default(OPEN)

  memberships  Membership[]
  transactions Transaction[]
  refunds      Refund[]

  createdById      String?
  createdBy        User?   @relation("PoolCreator", fields: [createdById], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  stateChangedAt DateTime @default(now())

  @@map("pools")
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  pools Pool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Membership {
  id String @id @default(uuid())

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  state    MembershipState @default(JOINED)
  joinedAt DateTime        @default(now())

  transactions Transaction[]
  refunds      Refund[]

  @@unique([poolId, userId])
  @@map("memberships")
}

model Transaction {
  id String @id @default(uuid())

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])

  // Co-Buy-generated reference (e.g. "CB-{poolId}-{userId}-{nonce}"), sent to
  // Monnify at init and echoed back on every webhook — the primary lookup key.
  paymentReference String @unique
  // Monnify's own reference for the transaction, known once init-transaction
  // responds (and reconfirmed on the webhook).
  monnifyTransactionReference String? @unique

  dynamicAccountNumber    String?
  dynamicAccountBankCode  String?
  dynamicAccountExpiresAt DateTime?

  // Amounts are stored in Naira, matching Pool.targetAmount/memberShareAmount —
  // converted to/from kobo only at the Monnify API boundary.
  amountExpected Int
  amountPaid     Int?

  // Payer's source account, captured from the collection webhook — this is
  // where a refund would be sent if the pool later fails to fund.
  sourceAccountNumber String?
  sourceBankCode      String?
  sourceAccountName   String?

  state  TransactionState @default(PENDING)
  paidAt DateTime?

  refund Refund?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model Refund {
  id String @id @default(uuid())

  transactionId String     @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id])

  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id])

  // Co-Buy-generated reference sent to Monnify ("CB-RF-{transactionId}-{nonce}").
  refundReference String @unique
  // Monnify's own reference, confirmed on the refund webhook.
  monnifyRefundReference String?

  amount Int

  // Where the money goes back to — copied from the source Transaction's
  // sourceAccountNumber/sourceBankCode at the time the refund is initiated.
  destinationAccountNumber String
  destinationBankCode      String

  state       RefundState @default(INITIATED)
  finalizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refunds")
}
