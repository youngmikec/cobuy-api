# Database
DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Optional: Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Email delivery
# EMAIL_PROVIDER selects which provider is used to send email: "smtp" or "brevo".
EMAIL_PROVIDER=brevo
# Max time (ms) allowed for a single email send before it's treated as failed.
EMAIL_SEND_TIMEOUT_MS=10000
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Co-Buy

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@co-buy.com

# Brevo (used when EMAIL_PROVIDER=brevo) — https://developers.brevo.com
