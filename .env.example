# Database
DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development
# Public base URL for this API — used to build pool share links, the Monnify
# payment redirect, and the "Production" entry in the Swagger server list.
APP_BASE_URL=https://cobuy.app

# Socket.IO CORS origin — client is mobile-only (no browser frontend), so
# there's no specific origin to allowlist; left permissive by design.
SOCKET_CORS_ORIGIN=*

# Optional: Logging level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Email delivery
# EMAIL_PROVIDER selects which provider is used to send email: "smtp" or "brevo".
EMAIL_PROVIDER=brevo
# Max time (ms) allowed for a single email send before it's treated as failed.
EMAIL_SEND_TIMEOUT_MS=10000
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Co-Buy

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@co-buy.com

# Brevo (used when EMAIL_PROVIDER=brevo) — https://developers.brevo.com


# Monnify — https://developers.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com/api/v1
# sandbox | production — controls whether webhook signature verification runs
# (Monnify only sends the monnify-signature header on production webhooks)
MONNIFY_ENV=sandbox
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_MERCHANT_CODE=
# Wallet/account number used as the default for the wallet balance check
MONNIFY_MERCHANT_ACCOUNT_NUMBER=
# Max time (ms) allowed for a single Monnify API call before it's treated as failed.
MONNIFY_REQUEST_TIMEOUT_MS=15000

# Platform fee taken out of amountRaised before disbursing to the beneficiary
# (e.g. 2 = 2%). No admin UI yet, so this is env-configured for now.
PLATFORM_FEE_PERCENT=2
SOCKET_CORS_ORIGIN=*